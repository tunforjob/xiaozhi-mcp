# MCP WebSocket Endpoint
# Замените на ваш реальный WebSocket endpoint
MCP_ENDPOINT=ws://your-websocket-server:port/path

# Опционально: Путь к конфигурации (если используете не ./mcp_config.json)
# MCP_CONFIG=/path/to/custom/config.json

# Bring! API Credentials (for grocery list functionality)
BRING_EMAIL=your-email@example.com
BRING_PASSWORD=your-password
TAVILY_API_KEY=

# Microsoft Outlook / Teams Calendar (via O365 library)
# Register an app at https://portal.azure.com/ → Azure Active Directory → App registrations
# Grant "Calendars.Read" delegated permission under Microsoft Graph
O365_CLIENT_ID=your-azure-app-client-id
O365_CLIENT_SECRET=your-azure-app-client-secret
# Optional: set your tenant ID for single-tenant apps (default: 'common' = multi-tenant)
# O365_TENANT_ID=your-tenant-id